# 환경변수 예시 — 이름만 적는다. 실제 값은 절대 커밋하지 않는다.
#
# 로컬:  이 파일을 .env 로 복사한 뒤 값을 채운다 (.env 는 .gitignore 대상)
# 배포:  Vercel → Project → Settings → Environment Variables
# 수집:  GitHub → Settings → Secrets and variables → Actions

# ── SIMMONS IG (Apify Instagram Scraper) ──────────────────────────────────
# Apify 개인 API 토큰. https://console.apify.com/settings/integrations
APIFY_TOKEN=
# 수집할 인스타그램 계정 아이디 (@ 없이). 비우면 simmonskorea 를 쓴다.
INSTAGRAM_USERNAME=

# ── 기상청 기상특보 (공공데이터포털) ───────────────────────────────────────
# 없으면 특보 연동만 건너뛰고 나머지는 정상 동작한다.
KMA_SERVICE_KEY=

# ── 예측 카드 해설 문장 (선택) ─────────────────────────────────────────────
# 없으면 각 예측 모듈이 통계 예측값만 표시한다.
ANTHROPIC_API_KEY=
