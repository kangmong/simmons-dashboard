{
  "version": 2,
  "builds": [
    {
      "src": "api/update.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "*.py",
          "public/data/schedule-reliability.json"
        ]
      }
    },
    {
      "src": "api/weather_news.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "logo.svg",
      "use": "@vercel/static"
    },
    {
      "src": "world-map.svg",
      "use": "@vercel/static"
    },
    {
      "src": "public/data/dashboard.json",
      "use": "@vercel/static"
    },
    {
      "src": "public/data/koima-price.json",
      "use": "@vercel/static"
    },
    {
      "src": "public/data/simmons-market.json",
      "use": "@vercel/static"
    },
    {
      "src": "public/data/global-sleeptech.json",
      "use": "@vercel/static"
    },
    {
      "src": "public/logos/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/maps/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/update",
      "methods": [
        "GET",
        "POST"
      ],
      "dest": "/api/update.py"
    },
    {
      "src": "/api/weather-news",
      "methods": [
        "GET"
      ],
      "dest": "/api/weather_news.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
